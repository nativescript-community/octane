{
  "name": "@nativescript-community/vite-octane",
  "version": "0.2.0",
  "description": "Octane for @nativescript/vite",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nativescript/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "@nativescript/source": "./src/client/strategy.ts",
      "types": "./dist/client/strategy.d.ts",
      "import": "./dist/client/strategy.js",
      "default": "./dist/client/strategy.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "nativescript": {
    "vite": {
      "flavor": "octane",
      "config": {
        "import": "octaneConfig",
        "from": "@nativescript-community/vite-octane"
      }
    }
  },
  "peerDependencies": {
    "@nativescript/vite": ">=8.0.0-dev.0",
    "@octanejs/vite-plugin": ">=0.1.51",
    "vite": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nativescript-community/octane",
    "directory": "packages/vite-octane"
  },
  "homepage": "https://github.com/nativescript-community/octane",
  "keywords": [
    "nativescript",
    "octane",
    "vite",
    "hmr"
  ],
  "dependencies": {
    "@nativescript-community/octane": "^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
